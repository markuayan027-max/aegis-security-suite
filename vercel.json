{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/public/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/public/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/react",
      "destination": "/replit"
    },
    {
      "source": "/suite",
      "destination": "/replit"
    }
  ]
}
